{
  "version": 2,
  "builds": [
    {
      "src": "white_board_tool/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.9",
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "white_board_tool/wsgi.py" }
  ]
}
